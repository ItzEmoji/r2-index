{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "labels": false,
        "assets": [
          {
            "path": "dist/index.js",
            "name": "r2-index.js",
            "label": "r2-index.js (paste into the Cloudflare dashboard editor)"
          }
        ]
      }
    ]
  ]
}
